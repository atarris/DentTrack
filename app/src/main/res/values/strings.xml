    <string name="reset_title">Reset app configuration</string>
    <string name="reset_text">Puts the settings on this screen and on the Backup tab back to their defaults. Stock, the activity log, users, categories, the language and the Admin password are kept.</string>
    <string name="reset_confirm_title">Reset app configuration?</string>
    <string name="reset_confirm_text">Low stock threshold, inactivity timeout and Hide Admin user go back to their defaults. Automatic backups and the monthly Drive upload are turned off, and the chosen backup folder and Google Drive connection are forgotten.</string>
