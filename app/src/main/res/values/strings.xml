    <string name="remove_password_text">Anyone who holds the “DentTrack” title for 3 seconds will get into the Admin menu without a password. They could change items, users and settings, or clear the log.</string>
    <string name="clear_stock_title">Clear stock database</string>
    <string name="clear_stock_text">Deletes every item and category, to start again or before a fresh import. Users, settings and the Admin password are kept. Make a backup first: this cannot be undone.</string>
    <string name="clear_stock_confirm_title">Clear the stock database?</string>
    <string name="clear_stock_confirm_text">All items, their quantities and all categories will be deleted. The only way back is restoring a backup.</string>
